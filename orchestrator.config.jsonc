{
  "$schema": "https://raw.githubusercontent.com/hyw007726/multi-agent-orchestrator-skill/main/references/orchestrator-config.schema.json",
  
  "default_cli": "agy",
  "orchestrator_cli": "codex",

  "orchestrator_cli_timeout_ms": 120000,
  "default_timeout_mins": 15,
  "default_progress_timeout_mins": 15,

  "cli_health_checks": {
    "agy": "agy --help",
    "copilot": "copilot --version",
    "codex": "codex --version"
  },

  "cli_templates": {
    "agy": {
      "cmd": "agy",
      "args": ["--dangerously-skip-permissions", "--output-format", "text", "-p", { "prompt_text": true }]
    },
    "copilot": {
      "cmd": "copilot",
      "args": ["-p", "-", "--yolo", "--no-ask-user"],
      "stdin": { "prompt_file": true }
    },
    "codex": {
      "cmd": "codex",
      "args": ["exec", "--dangerously-bypass-approvals-and-sandbox"],
      "stdin": { "prompt_file": true }
    }
  },

  "reviewers": [
    {
      "name": "codex-reviewer",
      "cli": "codex",
      "review_focus": "Technical architecture, boundary integrity, and risk analysis"
    },
    {
      "name": "copilot-reviewer",
      "cli": "copilot",
      "review_focus": "Implementation viability, dependency alignment, and deliverable coverage"
    }
  ]
}
